# =============================================================================
# mcp-searxng configuration template
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# All LLM endpoints are OpenAI-compatible (e.g. local servers via Ollama,
# vLLM, llama.cpp, LM Studio, or remote providers).
#
# Each of the three LLM roles is independently configured. The server always
# starts regardless of which roles are configured; unconfigured roles log a
# warning at startup and fail at use time with a specific error.
#   - web_search           : needs no LLM
#   - web_url_read         : needs the Script Generator
#   - image captioning     : needs the Captioner (vision-capable)
#   - Cloudflare/JS bypass : needs the Fallback-fetch Agent (vision + tool-use)
# =============================================================================


# -----------------------------------------------------------------------------
# SearXNG
# -----------------------------------------------------------------------------
# URL of your SearXNG instance. Used by web_search.
SEARXNG_URL=http://localhost:8888


# -----------------------------------------------------------------------------
# Cache
# -----------------------------------------------------------------------------
# Path to the SQLite database for the Page cache and Image cache.
# Default: ./cache.db (relative to the working directory).
SEARXNG_CACHE_PATH=./cache.db

# Directory for caching generated scripts.
# Default: ./scripts/ (relative to the working directory).
SCRIPT_CACHE_DIR=./scripts/


# -----------------------------------------------------------------------------
# Script Generator (code-capable LLM for HTML-to-script generation)
# -----------------------------------------------------------------------------
# Generates Python scripts from HTML content. Produces executable code that
# extracts structured data from web pages. Must support code generation.
# Required for web_url_read on cache misses.
SCRIPT_GEN_BASE_URL=http://localhost:11434/v1
SCRIPT_GEN_API_KEY=
SCRIPT_GEN_MODEL=


# -----------------------------------------------------------------------------
# Captioner (vision-capable LLM for image descriptions)
# -----------------------------------------------------------------------------
# Produces comprehensive descriptions of images (contents, OCR'd text, layout,
# colors, inferred type). Must accept image input. Required for image
# captioning on pages with images.
CAPTIONER_BASE_URL=http://localhost:11434/v1
CAPTIONER_API_KEY=
CAPTIONER_MODEL=


# -----------------------------------------------------------------------------
# Fallback-fetch Agent (vision + tool-use LLM for browser orchestration)
# -----------------------------------------------------------------------------
# Drives playwright-mcp to fetch pages that httpx can't reach (Cloudflare,
# JS-heavy). Must support OpenAI-compatible function/tool calling and accept
# image input (screenshots for page-state judgment). Required for the
# Fallback path on Primary-fetch failure.
AGENT_BASE_URL=http://localhost:11434/v1
AGENT_API_KEY=
AGENT_MODEL=


# -----------------------------------------------------------------------------
# Rate Limiting (protects LLM endpoints from concurrent overload)
# -----------------------------------------------------------------------------
# Maximum concurrent LLM requests per endpoint (semaphore size).
# Set this to match your LLM server's parallelism limit (e.g. Ollama num_parallel).
LLM_SEMAPHORE_SIZE=2

# Maximum seconds to wait for a semaphore slot before refusing the request.
LLM_SEMAPHORE_TIMEOUT=90

# Maximum number of retries on HTTP 429 (rate limited) responses from the LLM.
LLM_MAX_RETRIES=5

# Base delay in seconds for exponential backoff on 429 retries.
# Actual delay = LLM_BACKOFF_BASE * 2^(attempt-1), e.g. 1, 2, 4, 8, 16 seconds.
LLM_BACKOFF_BASE=1
